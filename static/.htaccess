# Dinahosting gestiona HTTPS a nivell de servidor (SSL termination al proxy).
# NO afegir redirect HTTPS aquí — causaria bucle infinit de redireccions.

# Opcions específiques del site estàtic.

# Pàgina d'error 404 personalitzada
ErrorDocument 404 /404.html

# Compressió
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# Tipus MIME que Dinahosting no reconeix per defecte
AddType image/webp .webp

# Cache d'assets estàtics
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Capçaleres de seguretat
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"

  # HSTS — el navegador força HTTPS durant 1 any. Sense includeSubDomains
  # ni preload (decisió conservadora: no bloquegem cap subdomini futur).
  # Dinahosting ja serveix sempre per HTTPS; el navegador només aplica HSTS
  # si rep la capçalera per HTTPS, així que no pot crear cap bucle.
  Header always set Strict-Transport-Security "max-age=31536000"

  # Aïllament entre orígens (baix risc).
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Cross-Origin-Resource-Policy "same-origin"

  # Permissions-Policy: desactivem capacitats que el lloc no fa servir.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Content-Security-Policy.
  # Nota: 'unsafe-inline' és necessari perquè el lloc té scripts i estils
  # en línia generats per Hugo (no hi ha servidor per posar nonces).
  # Tot i així, la CSP bloqueja orígens d'script desconeguts, object/embed,
  # el segrest de <base>, i l'encaix del lloc en iframes de tercers.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.paypal.com https://*.paypalobjects.com https://gc.zgo.at https://tally.so; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://api.web3forms.com https://*.paypal.com https://gc.zgo.at https://*.goatcounter.com https://overpass-api.de; frame-src 'self' https://*.paypal.com https://tally.so; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
</IfModule>

# Evitar llistat de directoris
Options -Indexes

# ============================================================
# 301 Redirects — migració WordPress → Hugo
# Cobreix les 433 URLs amb 404 detectades a Google Search Console
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Host canònic: www → sense www -------------------------------
  # sense això, www.llumatics.com serveix 200 amb el mateix contingut
  # i el lloc té dos allotjaments vius. El canònic de hugo.toml és
  # llumatics.com sense www, així que el www ha de redirigit-hi.
  RewriteCond %{HTTP_HOST} ^www\.llumatics\.com$ [NC]
  RewriteRule ^ https://llumatics.com%{REQUEST_URI} [R=301,L]

  # --- Prefix erroni /llumatics-web/ (totes les variants) ---
  RewriteRule ^llumatics-web/en/(.*)$ https://llumatics.com/en/$1 [R=301,L]
  RewriteRule ^llumatics-web/es/(.*)$ https://llumatics.com/es/$1 [R=301,L]
  RewriteRule ^llumatics-web/(.*)$ https://llumatics.com/$1 [R=301,L]

  # --- Canonical: /ca/ (l'idioma per defecte no porta prefix) → arrel ------
  # Hugo genera un stub meta-refresh a /ca/ perquè defaultContentLanguageInSubdir
  # és false. Un 301 real és més net per a cercadors i usuaris.
  RewriteRule ^ca/?$ https://llumatics.com/ [R=301,L]
  # Excepció: el sitemap de CA viu a /ca/sitemap.xml i el sitemap-index
  # l'hi referencia. Sense aquesta condició, el redireccionàvem a si mateix.
  RewriteCond %{REQUEST_URI} !^/ca/sitemap\.xml$
  RewriteRule ^ca/(.*)$ https://llumatics.com/$1 [R=301,L]

  # --- Paginació: els àlies /page/1/ són duplicats de la pàgina 1 ---------
  # Hugo generava 462 URLs /…/page/1/ idèntiques a la llista sense paginar.
  # Amb pagination.disableAliases ja no es creen; aquest 301 recull les que
  # Google pogués tenir indexades.
  RewriteRule ^(.*)page/1/?$ https://llumatics.com/$1 [R=301,L]

  # ── CA: pàgines estàtiques canviades de nom ──────────────
  RewriteRule ^sobre-nosaltres/?$ https://llumatics.com/sobre/ [R=301,L]
  RewriteRule ^les-nostres-installacions/?$ https://llumatics.com/espais/ [R=301,L]
  RewriteRule ^serveis/?$ https://llumatics.com/tallers/ [R=301,L]
  RewriteRule ^tallers/revelat-pelicula-bn/?$ https://llumatics.com/tallers/revelat-bn/ [R=301,L]

  # ── CA: posts i tallers antics ────────────────────────────
  RewriteRule ^apren-a-utilitzar-la-teva-camera-de-rodet[^/]*/?$ https://llumatics.com/tallers/fonaments-iniciacio-puntual/ [R=301,L]
  RewriteRule ^dia-mundial-de-la-fotografia-estenopeica-2025(/feed)?/?$ https://llumatics.com/blog/dia-mundial-fotografia-estenopeica-2025/ [R=301,L]
  RewriteRule ^immortalitzar-lanima-amb-la-fotografia-de-retrat/?$ https://llumatics.com/tallers/retrat-analogic/ [R=301,L]
  RewriteRule ^inscripcio-oberta-per-sessions-individuals/?$ https://llumatics.com/blog/sessions-individuals-2020/ [R=301,L]
  RewriteRule ^jornades-obertes-a-la-nau-bostik/?$ https://llumatics.com/blog/jornades-obertes-nau-bostik-2022/ [R=301,L]
  RewriteRule ^llumatics-es-trasllada-a-la-nau-bostik/?$ https://llumatics.com/blog/trasllat-nau-bostik/ [R=301,L]
  RewriteRule ^microsessio-fotografica-destudi-en-format-analogic(/feed)?/?$ https://llumatics.com/blog/sessio-maria-de-acha/ [R=301,L]
  RewriteRule ^resultats-del-taller-de-gran-format/?$ https://llumatics.com/blog/resultats-taller-gran-format-2018/ [R=301,L]
  RewriteRule ^resultats-del-taller-de-retrat-del-22-02-2019/?$ https://llumatics.com/blog/resultats-taller-retrat-2019-02/ [R=301,L]
  RewriteRule ^retrats-amb-holga-120-cfn-a-lestudi/?$ https://llumatics.com/tallers/retrat-amb-holga/ [R=301,L]
  RewriteRule ^streetphoto-fotografiant-la-ciutat(/feed)?/?$ https://llumatics.com/tallers/fotografia-de-carrer/ [R=301,L]
  RewriteRule ^taller-de-fotografia-tinta-i-sang-2/?$ https://llumatics.com/blog/halloween-bodypaint-2020/ [R=301,L]
  RewriteRule ^taller-diniciacio-a-la-fotografia-analogica-2/?$ https://llumatics.com/tallers/fonaments-iniciacio-puntual/ [R=301,L]
  RewriteRule ^taller-dintroduccio-al-positivat/?$ https://llumatics.com/tallers/introduccio-al-positivat/ [R=301,L]
  RewriteRule ^taller-el-meravellos-mon-hasselblad/?$ https://llumatics.com/tallers/hasselblad-500/ [R=301,L]
  RewriteRule ^taller-retrat-a-gran-format-a-lomography-embassy-barcelona/?$ https://llumatics.com/tallers/retrat-gran-format/ [R=301,L]
  RewriteRule ^un-dia-de-revelat-analogic-pluja-cameres-zenit-i-molta-passio-per-la-fotografia/?$ https://llumatics.com/blog/revelat-analogic-zenit-2025/ [R=301,L]
  # Slugs legacy en castellà a l'arrel (sense prefix /es/) — migració WordPress
  RewriteRule ^04-10-2025-taller-de-revelado-en-blanco-y-negro-en-cameras-films(/feed)?/?$ https://llumatics.com/tallers/revelat-bn/ [R=301,L]
  RewriteRule ^taller-de-iniciacion-a-la-fotografia-2/?$ https://llumatics.com/tallers/fonaments-iniciacio-puntual/ [R=301,L]
  RewriteRule ^taller-de-iniciacion-a-la-fotografia/?$ https://llumatics.com/tallers/fonaments-iniciacio-puntual/ [R=301,L]

  # ── ES: pàgines estàtiques canviades de nom ──────────────
  RewriteRule ^es/sobre-nosotros/?$ https://llumatics.com/es/sobre/ [R=301,L]
  RewriteRule ^es/nuestras-instalaciones/?$ https://llumatics.com/es/espais/ [R=301,L]
  RewriteRule ^es/servicios/?$ https://llumatics.com/es/tallers/ [R=301,L]
  RewriteRule ^es/contacto/?$ https://llumatics.com/es/contacte/ [R=301,L]
  RewriteRule ^es/politica-de-cookies/?$ https://llumatics.com/es/cookies/ [R=301,L]

  # ── ES: sessions de taller (URLs amb data, WP antic) ─────
  RewriteRule ^es/02-02-19-taller-de-revelado-en-blanco-y-negro/?$ https://llumatics.com/es/tallers/revelat-bn/ [R=301,L]
  RewriteRule ^es/03-05-2025-taller-de-revelado-en-blanco-y-negro-en-cameras-films[^/]*/?$ https://llumatics.com/es/blog/ [R=301,L]
  RewriteRule ^es/04-04-2020-taller-de-iniciacion-a-la-fotografia-analogica/?$ https://llumatics.com/es/tallers/fonaments-iniciacio-puntual/ [R=301,L]
  RewriteRule ^es/04-05-2019-taller-de-iniciacion-al-positivado/?$ https://llumatics.com/es/tallers/introduccio-al-positivat/ [R=301,L]
  RewriteRule ^es/04-10-2025-taller-de-revelado-en-blanco-y-negro-en-cameras-films/?$ https://llumatics.com/es/blog/ [R=301,L]
  RewriteRule ^es/05-07-2024-taller-de-forzados-en-el-festival-de-blues-de-barcelona/?$ https://llumatics.com/es/blog/taller-forcats-festival-blues-2024/ [R=301,L]
  RewriteRule ^es/06-07-2019-taller-de-revelado-en-blanco-en-blanco-y-negro-positivado(/feed)?/?$ https://llumatics.com/es/tallers/revelat-bn/ [R=301,L]
  RewriteRule ^es/07-03-2026-retrato-en-gran-formato-una-experiencia-analogica-para-todos/?$ https://llumatics.com/es/blog/retrat-gran-format-marc-2026/ [R=301,L]
  RewriteRule ^es/08-14-18-taller-de-revelado-en-blanco-y-negro/?$ https://llumatics.com/es/tallers/revelat-bn/ [R=301,L]
  RewriteRule ^es/10-08-2019-taller-de-cianotipia/?$ https://llumatics.com/es/tallers/cianotipia/ [R=301,L]
  RewriteRule ^es/11-05-19-taller-de-revelado-en-blanco-y-negro-con-forzados/?$ https://llumatics.com/es/tallers/revelats-experimentals/ [R=301,L]
  RewriteRule ^es/12-10-2019-taller-de-cianotipia(/feed)?/?$ https://llumatics.com/es/tallers/cianotipia/ [R=301,L]
  RewriteRule ^es/14-09-19-taller-de-retrato/?$ https://llumatics.com/es/tallers/retrat-analogic/ [R=301,L]
  RewriteRule ^es/15-11-2025-taller-de-fotogramas-con-cianotipia/?$ https://llumatics.com/es/blog/fotogrames-cianotipia-novembre-2025/ [R=301,L]
  RewriteRule ^es/18-02-18-taller-de-revelado-en-blanco-y-negro-con-forzado/?$ https://llumatics.com/es/tallers/revelat-bn/ [R=301,L]
  RewriteRule ^es/19-01-2019-taller-de-introduccion-al-positivado/?$ https://llumatics.com/es/tallers/introduccio-al-positivat/ [R=301,L]
  RewriteRule ^es/19-05-19-taller-de-iniciacion-a-la-fotografia-analogica/?$ https://llumatics.com/es/tallers/fonaments-iniciacio-puntual/ [R=301,L]
  RewriteRule ^es/20-07-2024-taller-de-revelado-en-blanco-y-negro-2-2/?$ https://llumatics.com/es/blog/revelat-lomography-juliol-2024/ [R=301,L]
  RewriteRule ^es/20-07-2024-taller-de-revelado-en-blanco-y-negro-2/?$ https://llumatics.com/es/blog/revelat-lomography-juliol-2024/ [R=301,L]
  RewriteRule ^es/20-07-2024-taller-de-revelado-en-blanco-y-negro/?$ https://llumatics.com/es/blog/revelat-lomography-juliol-2024/ [R=301,L]
  RewriteRule ^es/2024-08-24-taller-de-retrato-en-gran-formato-en-lomography-2/?$ https://llumatics.com/es/blog/retrat-gran-format-lomography-2024/ [R=301,L]
  RewriteRule ^es/2024-08-24-taller-de-retrato-en-gran-formato-en-lomography/?$ https://llumatics.com/es/blog/retrat-gran-format-lomography-2024/ [R=301,L]
  RewriteRule ^es/2025-02-01-taller-de-revelado-en-blanco-y-negro-a-lomography-embassy-barcelona/?$ https://llumatics.com/es/blog/ [R=301,L]
  RewriteRule ^es/21-03-2026-taller-de-revelado-en-blanco-y-negro-en-cameras-films/?$ https://llumatics.com/es/blog/ [R=301,L]
  RewriteRule ^es/21-09-19-taller-de-iniciacion-a-la-fotografia-analogica/?$ https://llumatics.com/es/tallers/fonaments-iniciacio-puntual/ [R=301,L]
  RewriteRule ^es/22-02-19-taller-de-retrato/?$ https://llumatics.com/es/blog/taller-retrat-febrer-2019/ [R=301,L]
  RewriteRule ^es/22-03-2025-taller-de-revelado-en-blanco-y-negro-en-cameras-films[^/]*/?$ https://llumatics.com/es/blog/ [R=301,L]
  RewriteRule ^es/23-11-19-taller-de-introduccion-al-gran-formato-revelado(/feed)?/?$ https://llumatics.com/es/tallers/gran-format-4x5/ [R=301,L]
  RewriteRule ^es/26-01-19-taller-de-revelado-en-blanco-y-negro-con-forzados/?$ https://llumatics.com/es/tallers/revelats-experimentals/ [R=301,L]
  RewriteRule ^es/28-29-03-2020-fotografias-de-tinta-y-sangre/?$ https://llumatics.com/es/blog/ [R=301,L]
  RewriteRule ^es/29-03-2025-taller-de-retrato-en-gran-formato-en-cameras-films[^/]*/?$ https://llumatics.com/es/tallers/retrat-gran-format/ [R=301,L]
  RewriteRule ^es/29-06-2019-taller-de-cianotipia/?$ https://llumatics.com/es/tallers/cianotipia/ [R=301,L]
  RewriteRule ^es/29-09-18-taller-de-introduccion-al-gran-formato/?$ https://llumatics.com/es/tallers/gran-format-4x5/ [R=301,L]
  RewriteRule ^es/31-08-2019-taller-de-revelado-en-blanco-y-negro-positivado/?$ https://llumatics.com/es/tallers/revelat-bn/ [R=301,L]

  # ── ES: posts antics sense data ──────────────────────────
  RewriteRule ^es/dia-mundial-de-la-fotografia-estenopeica(/feed)?/?$ https://llumatics.com/es/tallers/fotografia-estenopeica/ [R=301,L]
  RewriteRule ^es/fiesta-pinholera-perversa-en-la-nau-bostik/?$ https://llumatics.com/es/blog/festa-pinholera-perversa-2019/ [R=301,L]
  RewriteRule ^es/formulari-dinscripcio-al-taller-de-fotogrames-amb-cianotipia/?$ https://llumatics.com/es/tallers/fotogrames-cianotipia/ [R=301,L]
  RewriteRule ^es/halloween/?$ https://llumatics.com/es/blog/ [R=301,L]
  RewriteRule ^es/inscripcion-abierta-para-sesiones-individuales/?$ https://llumatics.com/es/blog/ [R=301,L]
  RewriteRule ^es/llumatics-se-traslada-a-nau-bostik(/feed)?/?$ https://llumatics.com/es/blog/ [R=301,L]
  RewriteRule ^es/microsesion-fotografica-de-estudio-en-formato-analogico/?$ https://llumatics.com/es/blog/sessio-maria-de-acha/ [R=301,L]
  RewriteRule ^es/resultado-del-pasado-taller-de-retrato/?$ https://llumatics.com/es/blog/taller-retrat-febrer-2019/ [R=301,L]
  RewriteRule ^es/resultados-del-taller-de-gran-formato/?$ https://llumatics.com/es/blog/resultats-taller-gran-format-2018/ [R=301,L]
  RewriteRule ^es/taller-de-fotografia-tinta-i-sang/?$ https://llumatics.com/es/blog/ [R=301,L]
  RewriteRule ^es/taller-de-iniciacion-a-la-fotografia-2/?$ https://llumatics.com/es/tallers/fonaments-iniciacio-puntual/ [R=301,L]
  RewriteRule ^es/taller-de-iniciacion-a-la-fotografia/?$ https://llumatics.com/es/tallers/fonaments-iniciacio-puntual/ [R=301,L]
  RewriteRule ^es/taller-de-iniciacion-al-positivado-2/?$ https://llumatics.com/es/tallers/introduccio-al-positivat/ [R=301,L]
  RewriteRule ^es/taller-de-revelado-con-caffenol/?$ https://llumatics.com/es/tallers/caffenol/ [R=301,L]
  RewriteRule ^es/taller-el-maravilloso-mundo-hasselblad/?$ https://llumatics.com/es/tallers/hasselblad-500/ [R=301,L]
  RewriteRule ^es/taller-retrato-en-gran-formato-en-lomography-embassy-barcelona/?$ https://llumatics.com/es/tallers/retrat-gran-format/ [R=301,L]
  RewriteRule ^es/un-dia-de-revelado-analogico-lluvia-camaras-zenit-y-mucha-pasion-por-la-fotografia/?$ https://llumatics.com/es/blog/revelat-analogic-zenit-2025/ [R=301,L]

  # ── Feeds genèrics (qualsevol que quedi) ─────────────────
  RewriteRule ^feed/?$ https://llumatics.com/ [R=301,L]
  RewriteRule ^es/feed/?$ https://llumatics.com/es/ [R=301,L]
  RewriteRule ^en/feed/?$ https://llumatics.com/en/ [R=301,L]
  RewriteRule ^(.+)/feed/?$ https://llumatics.com/$1/ [R=301,L]

  # ── EN: taxonomies i pàgines especials ───────────────────
  RewriteRule ^en/tags/.*$ https://llumatics.com/en/blog/ [R=301,L]
  RewriteRule ^en/tag/.*$ https://llumatics.com/en/blog/ [R=301,L]
  RewriteRule ^en/levels/.*$ https://llumatics.com/en/tallers/ [R=301,L]
  RewriteRule ^en/formats/.*$ https://llumatics.com/en/tallers/ [R=301,L]

  # ── ES: taxonomies i paginació ───────────────────────────
  RewriteRule ^es/tags/.*$ https://llumatics.com/es/blog/ [R=301,L]
  RewriteRule ^es/tag/.*$ https://llumatics.com/es/blog/ [R=301,L]
  RewriteRule ^es/category/.*$ https://llumatics.com/es/tallers/ [R=301,L]
  RewriteRule ^es/levels/.*$ https://llumatics.com/es/tallers/ [R=301,L]
  RewriteRule ^es/page/[0-9]+/?$ https://llumatics.com/es/blog/ [R=301,L]

  # ── CA: taxonomies i paginació ───────────────────────────
  # Tag duplicat històric: "cameras and films" → "Cameras & Films" (slug cameras--films)
  RewriteRule ^tags/cameras-and-films/?$ https://llumatics.com/tags/cameras--films/ [R=301,L]
  RewriteRule ^tag/.*$ https://llumatics.com/blog/ [R=301,L]
  RewriteRule ^category/.*$ https://llumatics.com/tallers/ [R=301,L]
  RewriteRule ^page/[0-9]+/?$ https://llumatics.com/blog/ [R=301,L]

  # ── Barra final, sempre en https ────────────────────────────
  # Aquesta ha de ser la ÚLTIMA regla del bloc, perquè els 301
  # específics de dalt (WordPress) es resolguin abans.
  #
  # Per què cal: el TLS el acaba el proxy de Dinahosting, de manera que
  # Apache veu la connexió com a http i el redirect automàtic de
  # DirectorySlash (mod_dir) emet Location: http://... Sense això,
  # https://llumatics.com/tallers respon 301 cap a http://llumatics.com/tallers/
  # i el torna a|pujar a https: dos salts i un tram en text pla. Els
  # lectors d'IA i els clients que forcen http→https hi entren en bucle
  # i acaben retornant "massa redireccions".
  #
  # NO hi ha cap condició sobre l'esquema: aquesta regla sempre apunta
  # a https, per la qual cosa no pot crear cap bucle.
  # !-f protegeix els fitxers reals sense barra (humans.txt, llms.txt,
  # form-handler.php): si no, passarien a 301 cap a /fitxer/.
  # -d: només afegim la barra a directoris reals (les pàgines de Hugo ho són).
  # Sense això, una URL inexistent rebia un 301 abans del 404.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+[^/])$ https://llumatics.com/$1/ [R=301,L]

</IfModule>
