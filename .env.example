# .env.example — Copia aquest fitxer com a .env i omple els valors
# El fitxer .env NO s'inclou al repositori (és al .gitignore)

# Webhook de Make.com per a notificació de tallers nous a Instagram
MAKECOM_INSTAGRAM_TALLER_WEBHOOK=

# Webhook de Make.com per a notificació de noves dates d'agenda
MAKECOM_INSTAGRAM_AGENDA_WEBHOOK=
